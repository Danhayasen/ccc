<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../UnityRefs.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS0649: a Unity suprime este aviso em campos [SerializeField] -->
    <NoWarn>$(NoWarn);MSB3277;CS0649</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SkyCrew.Editor</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../Assets/_Project/Scripts/Editor/**/*.cs" />
    <Reference Include="../../refs/UnityEditor/UnityEditor.dll" Private="false" />
    <ProjectReference Include="../SkyCrew.Runtime/SkyCrew.Runtime.csproj" />
    <ProjectReference Include="../../Domain/SkyCrew.Domain.csproj" />
  </ItemGroup>
</Project>
